; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3D PARTY WORLD"
config/description="Cross-platform online 3D party game (dedicated server)."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Net="*res://scripts/networking/network_manager.gd"
Auth="*res://scripts/auth/firebase_auth.gd"
PlayerData="*res://scripts/data/player_data.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventKey,"device":-1,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventKey,"device":-1,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventKey,"device":-1,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventKey,"device":-1,"physical_keycode":4194321)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32)]
}
walk={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69)]
}
emote_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":49)]
}
emote_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":50)]
}
emote_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":51)]
}
emote_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":52)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
